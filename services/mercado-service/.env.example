# Infraestrutura (§5). No kit, use as credenciais e hosts fornecidos pela Infra.
DATABASE_URL=postgresql://svc_mercado:<senha>@pg-primary:5432/portal_b2b
MIGRATION_DATABASE_URL=postgresql://portal_ddl:<senha>@pg-primary:5432/portal_b2b
KAFKA_BOOTSTRAP_SERVERS=rp-0:9092,rp-1:9092,rp-2:9092
KAFKA_GROUP_ID=mercado-service-v1
JWKS_URL=http://gateway:8080/.well-known/jwks.json
JWT_ISSUER=identity-service
JWT_AUDIENCE=b2b-platform
LOG_LEVEL=INFO

# Negócio (ConfigMercado). Valores inválidos impedem a subida.
EXCESSO_DEMANDA_MINIMO_PERCENTUAL=0
LEILAO_JANELA_ADESAO_MINUTOS=60
LEILAO_DURACAO_HORAS=24
LEILAO_INCREMENTO_MINIMO_PERCENTUAL=1

# Só no override do kit (compose.mercado.yml): caminho absoluto desta pasta e DSNs com nomes próprios,
# para não colidir com as variáveis dos outros serviços no mesmo comando.
MERCADO_PROJECT_DIR=
MERCADO_DATABASE_URL=
MERCADO_MIGRATION_DATABASE_URL=
