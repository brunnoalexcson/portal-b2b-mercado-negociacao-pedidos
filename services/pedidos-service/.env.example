# Para o kit. Use credenciais e hosts fornecidos pela Infra.
DATABASE_URL=
MIGRATION_DATABASE_URL=
KAFKA_BOOTSTRAP_SERVERS=rp-0:9092,rp-1:9092,rp-2:9092
KAFKA_GROUP_ID=pedidos-service-v1
# Sem JWKS_URL, usa http://usuarios-service:8101/.well-known/jwks.json (rede interna da AWS).
JWKS_URL=http://app1-usuarios:8080/.well-known/jwks.json
JWT_ISSUER=identity-service
JWT_AUDIENCE=b2b-platform
LOG_LEVEL=INFO
