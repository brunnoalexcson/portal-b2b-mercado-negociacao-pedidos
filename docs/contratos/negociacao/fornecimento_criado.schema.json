{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/contratos/negociacao/fornecimento_criado.schema.json",
  "title": "fornecimento_criado",
  "description": "Consumido pelo negociacao-service para a cópia local da oferta (RF-14). Lista só os campos que o serviço usa; os demais campos do contrato do Fornecimento são aceitos e ignorados. Chave: fornecimentoId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "fornecimento_criado"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "fornecimentos-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "fornecimentoId",
        "fornecedorId",
        "produtoId",
        "preco",
        "quantidadeDisponivel",
        "criadoEm"
      ],
      "additionalProperties": true,
      "properties": {
        "fornecimentoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "fornecedorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "produtoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "preco": {
          "type": "number",
          "minimum": 0
        },
        "quantidadeDisponivel": {
          "type": "number",
          "minimum": 0
        },
        "criadoEm": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
