{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/contratos/negociacao/modo_negociacao_definido.schema.json",
  "title": "modo_negociacao_definido",
  "description": "Consumido pelo negociacao-service (RF-02): o mercado-service publica quando abre uma negociação direta (ESP-MRC-001 RF-08) ou fecha o lote de um leilão. Com modo VENDA_DIRETA, abre a negociação direta com o mesmo negociacaoId; com LEILAO_DIRETO, a mensagem é ignorada, porque o leilão é aberto pelo leilao_iniciado (RN-02). Lista só os campos usados. Chave: negociacaoId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "modo_negociacao_definido"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "mercado-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "negociacaoId",
        "modo"
      ],
      "additionalProperties": true,
      "properties": {
        "negociacaoId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "modo": {
          "enum": [
            "VENDA_DIRETA",
            "LEILAO_DIRETO"
          ]
        },
        "produtoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "demandas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "compradorId"
            ],
            "additionalProperties": true,
            "properties": {
              "compradorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              }
            }
          }
        },
        "ofertas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fornecimentoId",
              "fornecedorId",
              "quantidade",
              "precoUnitario"
            ],
            "additionalProperties": true,
            "properties": {
              "fornecimentoId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "fornecedorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "quantidade": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Até 2 casas decimais; a precisão é validada pelo serviço."
              },
              "precoUnitario": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Reais (BRL), até 2 casas decimais; a precisão é validada pelo serviço."
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "modo": {
                "const": "VENDA_DIRETA"
              }
            }
          },
          "then": {
            "required": [
              "produtoId",
              "demandas",
              "ofertas"
            ],
            "properties": {
              "demandas": {
                "minItems": 1,
                "maxItems": 1
              },
              "ofertas": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
