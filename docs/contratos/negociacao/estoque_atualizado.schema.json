{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/contratos/negociacao/estoque_atualizado.schema.json",
  "title": "estoque_atualizado",
  "description": "Consumido pelo negociacao-service para manter o saldo da cópia local (RF-14). Chave: fornecimentoId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "estoque_atualizado"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "fornecimentos-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "fornecimentoId",
        "produtoId",
        "fornecedorId",
        "operacao",
        "quantidadeDisponivel",
        "atualizadoEm"
      ],
      "additionalProperties": true,
      "properties": {
        "fornecimentoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "produtoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "fornecedorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "operacao": {
          "enum": [
            "RESERVA",
            "LIBERACAO",
            "BAIXA",
            "REPOSICAO",
            "ENCERRAMENTO"
          ]
        },
        "quantidadeDisponivel": {
          "type": "number",
          "minimum": 0
        },
        "atualizadoEm": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
