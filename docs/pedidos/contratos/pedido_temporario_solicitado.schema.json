{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/pedidos/contratos/pedido_temporario_solicitado.schema.json",
  "title": "pedido_temporario_solicitado",
  "description": "Consumido pelo pedidos-service (ESP-PED-001 v2.1, §7.3). Campos adicionais do produtor são aceitos e ignorados. Chave Kafka e aggregateId: negociacaoId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "pedido_temporario_solicitado"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 com Z ou offset explícito."
    },
    "source": {
      "const": "negociacao-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "negociacaoId",
        "tipo",
        "fornecimentoId",
        "fornecedorId",
        "produtoId",
        "quantidade",
        "precoUnitario"
      ],
      "additionalProperties": true,
      "properties": {
        "negociacaoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "tipo": {
          "enum": [
            "LEILAO",
            "VENDA_DIRETA"
          ]
        },
        "fornecimentoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "fornecedorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "produtoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "quantidade": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9999999999.99,
          "description": "Até 2 casas decimais."
        },
        "precoUnitario": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 99999999999999.98,
          "description": "BRL, até 2 casas decimais."
        }
      }
    }
  }
}
