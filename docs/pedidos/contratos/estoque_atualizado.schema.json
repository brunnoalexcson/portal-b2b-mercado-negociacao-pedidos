{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/pedidos/contratos/estoque_atualizado.schema.json",
  "title": "estoque_atualizado",
  "description": "Consumido pelo pedidos-service (ESP-PED-001 v2.2, §7.3). Campos adicionais do produtor são aceitos e ignorados. Chave Kafka e aggregateId: fornecimentoId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "estoque_atualizado"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 com Z ou offset explícito."
    },
    "source": {
      "const": "fornecimentos-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "fornecimentoId",
        "produtoId",
        "fornecedorId",
        "operacao",
        "quantidadeMovimentada",
        "quantidadeDisponivel",
        "quantidadeReservada",
        "pedidoId",
        "atualizadoEm"
      ],
      "additionalProperties": true,
      "properties": {
        "fornecimentoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "produtoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "fornecedorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "operacao": {
          "enum": [
            "RESERVA",
            "LIBERACAO",
            "BAIXA",
            "REPOSICAO",
            "ENCERRAMENTO"
          ]
        },
        "quantidadeMovimentada": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9999999999.99,
          "description": "Até 2 casas decimais."
        },
        "quantidadeDisponivel": {
          "type": "number",
          "minimum": 0,
          "maximum": 9999999999.99,
          "description": "Até 2 casas decimais."
        },
        "quantidadeReservada": {
          "type": "number",
          "minimum": 0,
          "maximum": 9999999999.99,
          "description": "Até 2 casas decimais."
        },
        "pedidoId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "atualizadoEm": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 com Z ou offset explícito."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operacao": {
                "enum": [
                  "RESERVA",
                  "LIBERACAO",
                  "BAIXA"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "pedidoId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            }
          },
          "else": {
            "properties": {
              "pedidoId": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
