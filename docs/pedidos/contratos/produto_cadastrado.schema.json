{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/pedidos/contratos/produto_cadastrado.schema.json",
  "title": "produto_cadastrado",
  "description": "Consumido pelo pedidos-service (ESP-PED-001 v2.1, §7.3). Campos adicionais do produtor são aceitos e ignorados. Chave Kafka e aggregateId: produtoId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "produto_cadastrado"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 com Z ou offset explícito."
    },
    "source": {
      "const": "produtos-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "produtoId",
        "nome",
        "unidade",
        "tipoTransporte"
      ],
      "additionalProperties": true,
      "properties": {
        "produtoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "nome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "unidade": {
          "enum": [
            "KG",
            "TON",
            "UN",
            "CX",
            "L"
          ]
        },
        "tipoTransporte": {
          "enum": [
            "GRANEL",
            "REFRIGERADO",
            "CARGA_SECA",
            "PERIGOSO"
          ]
        },
        "pesoUnitarioKg": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 99999.999,
              "description": "Até 3 casas decimais."
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
