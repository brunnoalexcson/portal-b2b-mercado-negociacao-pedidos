{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/pedidos/contratos/pedido_atualizado.schema.json",
  "title": "pedido_atualizado",
  "description": "Publicado pelo pedidos-service (ESP-PED-001 v2.2, §7.4). Um evento por versão nova do pedido, a partir da 2. Chave Kafka e aggregateId: pedidoId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "pedido_atualizado"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 com Z ou offset explícito."
    },
    "source": {
      "const": "pedidos-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "pedidoId",
        "negociacaoId",
        "fornecimentoId",
        "status",
        "statusAnterior",
        "reservaSituacao",
        "versao"
      ],
      "additionalProperties": false,
      "properties": {
        "pedidoId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "negociacaoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "fornecimentoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "CRIADO",
            "VENDA_CONCLUIDA",
            "AGUARDANDO_FRETE",
            "FRETE_SELECIONADO",
            "ENTREGUE",
            "CANCELADO"
          ]
        },
        "statusAnterior": {
          "enum": [
            "CRIADO",
            "VENDA_CONCLUIDA",
            "AGUARDANDO_FRETE",
            "FRETE_SELECIONADO",
            "ENTREGUE",
            "CANCELADO"
          ]
        },
        "reservaSituacao": {
          "enum": [
            "PENDENTE",
            "CONFIRMADA",
            "RECUSADA",
            "ENCERRADA"
          ]
        },
        "versao": {
          "type": "integer",
          "minimum": 2
        },
        "motivo": {
          "enum": [
            "ESTOQUE_INSUFICIENTE",
            "FORNECIMENTO_INEXISTENTE",
            "FORA_DO_LOTE",
            "NEGOCIACAO_SEM_VENDA"
          ]
        },
        "compradorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "fornecedorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "produtoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "produtoNome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "quantidade": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 9999999999.99,
          "description": "Até 2 casas decimais."
        },
        "unidade": {
          "enum": [
            "KG",
            "TON",
            "UN",
            "CX",
            "L"
          ]
        },
        "pesoKg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Quilos, até 3 casas decimais."
        },
        "tipoTransporte": {
          "enum": [
            "GRANEL",
            "REFRIGERADO",
            "CARGA_SECA",
            "PERIGOSO"
          ]
        },
        "valorUnitario": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 99999999999999.98,
          "description": "BRL, até 2 casas decimais."
        },
        "valorTotal": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 99999999999999.98,
          "description": "BRL, até 2 casas decimais."
        },
        "origem": {
          "type": "object",
          "required": [
            "cidade",
            "uf"
          ],
          "additionalProperties": false,
          "properties": {
            "cidade": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "\\S"
            },
            "uf": {
              "enum": [
                "AC",
                "AL",
                "AP",
                "AM",
                "BA",
                "CE",
                "DF",
                "ES",
                "GO",
                "MA",
                "MT",
                "MS",
                "MG",
                "PA",
                "PB",
                "PR",
                "PE",
                "PI",
                "RJ",
                "RN",
                "RS",
                "RO",
                "RR",
                "SC",
                "SP",
                "SE",
                "TO"
              ]
            }
          }
        },
        "destino": {
          "type": "object",
          "required": [
            "cidade",
            "uf"
          ],
          "additionalProperties": false,
          "properties": {
            "cidade": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "\\S"
            },
            "uf": {
              "enum": [
                "AC",
                "AL",
                "AP",
                "AM",
                "BA",
                "CE",
                "DF",
                "ES",
                "GO",
                "MA",
                "MT",
                "MS",
                "MG",
                "PA",
                "PB",
                "PR",
                "PE",
                "PI",
                "RJ",
                "RN",
                "RS",
                "RO",
                "RR",
                "SC",
                "SP",
                "SE",
                "TO"
              ]
            }
          }
        },
        "dataEntregaDesejada": {
          "type": "string",
          "format": "date"
        },
        "frete": {
          "type": "object",
          "required": [
            "solicitacaoFreteId",
            "entregaId",
            "cotacaoId",
            "transportadoraId",
            "tentativa",
            "preco",
            "prazoDias",
            "dataEntregaPrevista"
          ],
          "additionalProperties": false,
          "properties": {
            "solicitacaoFreteId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "\\S"
            },
            "entregaId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "\\S"
            },
            "cotacaoId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "\\S"
            },
            "transportadoraId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "\\S"
            },
            "tentativa": {
              "type": "integer",
              "minimum": 1
            },
            "preco": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 99999999999999.98,
              "description": "BRL, até 2 casas decimais."
            },
            "prazoDias": {
              "type": "integer",
              "minimum": 1
            },
            "dataEntregaPrevista": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "entregueEm": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 com Z ou offset explícito."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "CANCELADO"
              }
            }
          },
          "then": {
            "required": [
              "motivo"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "VENDA_CONCLUIDA"
              }
            }
          },
          "then": {
            "required": [
              "compradorId",
              "valorUnitario",
              "valorTotal"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "AGUARDANDO_FRETE"
              }
            }
          },
          "then": {
            "required": [
              "compradorId",
              "fornecedorId",
              "produtoId",
              "produtoNome",
              "quantidade",
              "unidade",
              "pesoKg",
              "tipoTransporte",
              "valorTotal",
              "origem",
              "destino"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FRETE_SELECIONADO"
              }
            }
          },
          "then": {
            "required": [
              "frete"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ENTREGUE"
              }
            }
          },
          "then": {
            "required": [
              "entregueEm"
            ]
          }
        }
      ]
    }
  }
}
