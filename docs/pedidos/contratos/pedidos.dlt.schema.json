{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/pedidos/contratos/pedidos.dlt.schema.json",
  "title": "pedidos.dlt",
  "description": "Publicado pelo pedidos-service com as mensagens rejeitadas (ESP-PED-001 v2.1, §7.4). Chave Kafka e aggregateId: chave original ou topico:particao:offset.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "pedidos.dlt"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 com Z ou offset explícito."
    },
    "source": {
      "const": "pedidos-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "originalEvent",
        "error",
        "stackTrace",
        "failedAtAttempt"
      ],
      "additionalProperties": false,
      "properties": {
        "originalEvent": {
          "description": "Objeto original, string truncada em 64 KiB ou null."
        },
        "error": {
          "enum": [
            "EVENTO_INVALIDO",
            "CONTRATO_DIVERGENTE",
            "FECHAMENTO_INCOMPATIVEL",
            "TENTATIVAS_ESGOTADAS"
          ]
        },
        "stackTrace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "failedAtAttempt": {
          "enum": [
            1,
            3
          ],
          "description": "3 em TENTATIVAS_ESGOTADAS; 1 nos demais."
        }
      }
    }
  }
}
