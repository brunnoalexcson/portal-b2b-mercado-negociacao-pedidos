{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/pedidos/contratos/negociacao_fechada.schema.json",
  "title": "negociacao_fechada",
  "description": "Consumido pelo pedidos-service (ESP-PED-001 v2.2, §7.3). Campos adicionais do produtor são aceitos e ignorados. Chave Kafka e aggregateId: negociacaoId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "negociacao_fechada"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 com Z ou offset explícito."
    },
    "source": {
      "const": "negociacao-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "negociacaoId",
        "tipo",
        "status",
        "compradorId",
        "produtoId",
        "alocacoes"
      ],
      "additionalProperties": true,
      "properties": {
        "negociacaoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "tipo": {
          "enum": [
            "LEILAO",
            "VENDA_DIRETA"
          ]
        },
        "status": {
          "enum": [
            "ENCERRADO",
            "DESERTO",
            "RECUSADO",
            "EXPIRADO"
          ]
        },
        "compradorId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "produtoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "alocacoes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fornecimentoId",
              "fornecedorId",
              "pedidoId",
              "quantidade",
              "valorUnitario",
              "valorTotal"
            ],
            "additionalProperties": true,
            "properties": {
              "fornecimentoId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "fornecedorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "pedidoId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "quantidade": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 9999999999.99,
                "description": "Até 2 casas decimais."
              },
              "valorUnitario": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 99999999999999.98,
                "description": "BRL, até 2 casas decimais."
              },
              "valorTotal": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 99999999999999.98,
                "description": "BRL, até 2 casas decimais."
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ENCERRADO"
              }
            }
          },
          "then": {
            "properties": {
              "compradorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "alocacoes": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "compradorId": {
                "type": "null"
              },
              "alocacoes": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
