{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/mercado/contratos/demanda_cancelada.schema.json",
  "title": "demanda_cancelada",
  "description": "Consumido pelo mercado-service (RF-04). Tópico proposto pelo grupo de Compra e Demanda, ainda fora do catálogo do kit. Chave: demandaId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "demanda_cancelada"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "demanda-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "demandaId",
        "compradorId",
        "canceladoEm"
      ],
      "additionalProperties": true,
      "properties": {
        "demandaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "compradorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "motivo": {
          "type": [
            "string",
            "null"
          ]
        },
        "canceladoEm": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
