{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/mercado/contratos/fornecimento_atualizado.schema.json",
  "title": "fornecimento_atualizado",
  "description": "Consumido pelo mercado-service para atualizar preço, saldo e origem da oferta (RF-01). Chave: fornecimentoId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "fornecimento_atualizado"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "fornecimentos-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "fornecimentoId",
        "fornecedorId",
        "produtoId",
        "unidade",
        "preco",
        "quantidadeDisponivel",
        "atualizadoEm"
      ],
      "additionalProperties": true,
      "properties": {
        "fornecimentoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fornecedorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "produtoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "unidade": {
          "enum": [
            "KG",
            "TON",
            "UN",
            "CX",
            "L"
          ]
        },
        "preco": {
          "type": "number",
          "minimum": 0
        },
        "quantidadeDisponivel": {
          "type": "number",
          "minimum": 0
        },
        "origem": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "cidade",
            "uf"
          ],
          "additionalProperties": true,
          "properties": {
            "cidade": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uf": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        },
        "atualizadoEm": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
