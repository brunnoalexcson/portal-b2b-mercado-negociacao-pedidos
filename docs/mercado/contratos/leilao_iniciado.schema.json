{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/mercado/contratos/leilao_iniciado.schema.json",
  "title": "leilao_iniciado",
  "description": "Publicado pelo mercado-service em T1, quando o lote da sugestão é fechado (RF-10), logo depois do modo_negociacao_definido do mesmo leilão. Consumidores: negociacao-service, que pede o pedido temporário de cada item e só libera os lances com todas as reservas confirmadas (DG-51), e front-end. Chave: negociacaoId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "leilao_iniciado"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "mercado-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "negociacaoId",
        "sugestaoId",
        "produtoId",
        "unidade",
        "quantidadeTotal",
        "precoInicial",
        "incrementoMinimo",
        "incrementoMinimoPercentual",
        "itens",
        "iniciaEm",
        "encerraEm"
      ],
      "additionalProperties": false,
      "properties": {
        "negociacaoId": {
          "type": "string",
          "format": "uuid"
        },
        "sugestaoId": {
          "type": "string",
          "format": "uuid"
        },
        "produtoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "unidade": {
          "enum": [
            "KG",
            "TON",
            "UN",
            "CX",
            "L"
          ]
        },
        "quantidadeTotal": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "precoInicial": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "incrementoMinimo": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "incrementoMinimoPercentual": {
          "type": "number",
          "minimum": 0
        },
        "itens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "fornecimentoId",
              "fornecedorId",
              "quantidade",
              "precoUnitario",
              "valorItem",
              "participacao",
              "origem"
            ],
            "additionalProperties": false,
            "properties": {
              "fornecimentoId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "fornecedorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "quantidade": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "precoUnitario": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "valorItem": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "participacao": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "origem": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "cidade",
                  "uf"
                ],
                "additionalProperties": true,
                "properties": {
                  "cidade": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "uf": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  }
                }
              }
            }
          }
        },
        "iniciaEm": {
          "type": "string",
          "format": "date-time"
        },
        "encerraEm": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
