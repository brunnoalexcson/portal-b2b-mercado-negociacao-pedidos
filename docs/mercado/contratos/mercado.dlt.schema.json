{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brunnoalexcson/portal-b2b-mercado-negociacao-pedidos/blob/main/docs/mercado/contratos/mercado.dlt.schema.json",
  "title": "mercado.dlt",
  "description": "Publicado pelo mercado-service quando uma mensagem consumida é inválida ou falha após 4 execuções (RF-15). Chave: aggregateId original, eventId original ou \"desconhecido\".",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "source",
    "correlationId",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "mercado.dlt"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "mercado-service"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "topicoOrigem",
        "originalEvent",
        "error",
        "detalhe",
        "stackTrace",
        "failedAtAttempt"
      ],
      "additionalProperties": false,
      "properties": {
        "topicoOrigem": {
          "type": "string",
          "minLength": 1
        },
        "originalEvent": {},
        "error": {
          "enum": [
            "EVENTO_INVALIDO",
            "PROCESSAMENTO_FALHOU"
          ]
        },
        "detalhe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "stackTrace": {
          "const": ""
        },
        "failedAtAttempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    }
  }
}
